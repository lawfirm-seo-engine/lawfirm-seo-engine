# ──────────────────────────────────────────────────────
# 관리자 페이지 (/admin) 필수 환경변수
# Vercel 프로젝트 설정 → Environment Variables에 추가하세요.
# ──────────────────────────────────────────────────────

# GitHub Fine-grained Personal Access Token
# 권한: Contents (Read & Write), Metadata (Read)
# 생성: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=ghp_your_token_here

# GitHub 저장소 정보 (기본값으로 자동 설정됨, 변경 시에만 지정)
# GITHUB_OWNER=lawfirm-seo-engine
# GITHUB_REPO=lawfirm-seo-engine
# GITHUB_BRANCH=main

# ──────────────────────────────────────────────────────
# 배포 상태 확인 (선택사항)
# ──────────────────────────────────────────────────────

# Vercel API Token (배포 상태 조회용)
# 생성: https://vercel.com/account/tokens
# VERCEL_TOKEN=your_vercel_token

# Vercel 프로젝트 ID (Vercel 대시보드 → Project Settings → General → Project ID)
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxx

# Vercel Team ID (팀 계정인 경우)
# VERCEL_TEAM_ID=team_xxxxxxxxxxxx

# ──────────────────────────────────────────────────────
# 강제 재배포 (선택사항)
# ──────────────────────────────────────────────────────

# Vercel Deploy Hook URL
# 생성: Vercel 대시보드 → Project Settings → Git → Deploy Hooks
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
